# Copy to .env next to docker-compose.yml and fill in.

# Required: long random string the ClStats app ("Access Token") and the token script send.
# Generate: openssl rand -hex 32
API_TOKEN=

# Optional: key that encrypts the stored claude.ai cookie. If empty, the server generates
# one on first start and keeps it in the data volume (data/secret.key).
SECRET_KEY=

# Optional: token that may only send token totals (POST /api/tokens). Put it into the token
# script's config on your computers instead of API_TOKEN. At least 24 characters.
INGEST_TOKEN=

# Optional: address or network of your reverse proxy, whose X-Forwarded-For header is
# trusted (e.g. 172.18.0.0/16 for its Docker network). Default 127.0.0.1.
# FORWARDED_ALLOW_IPS=172.18.0.0/16

# Time zone for daily statistics, e.g. Europe/Berlin, America/New_York.
TZ=UTC
# Seconds between polls of claude.ai (minimum 60).
POLL_INTERVAL=300

# Push notifications (APNs) only work with the APNs key of the app's developer.
# Self-hosted servers run without push: leave these empty.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_SANDBOX=false
ALERT_THRESHOLDS=50,75,90,100
